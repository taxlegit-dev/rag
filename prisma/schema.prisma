generator client {
  provider        = "prisma-client-js"
  engineType      = "binary"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  email        String        @id
  password     String
  ragDocuments RagDocument[]
}

model RagDocument {
  id             String     @id @default(uuid())
  sourceFileName String?
  uploadedByEmail String
  domains        Domain[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  chunks         RagChunk[]
  uploadedBy     User       @relation(fields: [uploadedByEmail], references: [email], onDelete: Cascade)
}

model RagChunk {
  id         String      @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String
  embedding  Unsupported("vector")
  createdAt  DateTime    @default(now())
  document   RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum Domain {
  ICFR
  AARAMBH
  NGO
  TAXLEGIT
  CSR
  DASHBOARD
}
